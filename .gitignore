# Raw/local MVP evidence: keep curated markdown reports trackable, keep
# screenshots, browser profiles, DOM/XML dumps, cookie jars, and raw runs local.
MVP_EVIDENCE/screenshots/**
MVP_EVIDENCE/test-runs/**
!MVP_EVIDENCE/test-runs/*.md
!MVP_EVIDENCE/reports/**

# Generated clients and derived artifacts
packages/generated/**

# Keep source-of-truth docs and source files trackable
!docs/**
!api/openapi/**
!api/schemas/**
!**/README.md
artifacts/evidence/**
security/scans/**

# Local QA/browser evidence. Keep raw browser profiles, sessions, screenshots,
# XML dumps, emulator logs, and credential probe outputs out of commits.
qa-artifacts/**
MVP_EVIDENCE/**/chrome-profile*/**
MVP_EVIDENCE/prod-*/qa-artifacts/**
MVP_EVIDENCE/prod-*/test-results/**
MVP_EVIDENCE/prod-*/traces/**
MVP_EVIDENCE/prod-*/*.session
MVP_EVIDENCE/**/logs/**
MVP_EVIDENCE/**/screenshots/**
MVP_EVIDENCE/**/xml/**
MVP_EVIDENCE/**/*cookie*
MVP_EVIDENCE/**/*credential*
MVP_EVIDENCE/**/*password*
MVP_EVIDENCE/**/*secret*
MVP_EVIDENCE/**/*session*
MVP_EVIDENCE/**/*token*

# Local project rules and raw MVP evidence. Keep curated sanitized reports trackable.
/MVP_EVIDENCE/**
!/MVP_EVIDENCE/**/
!/MVP_EVIDENCE/README.md
!/MVP_EVIDENCE/MVP_RELEASE_REPORT.md
!/MVP_EVIDENCE/release-checklist.md
!/MVP_EVIDENCE/reports-index.md
!/MVP_EVIDENCE/reports/**
!/MVP_EVIDENCE/**/*SANITIZED.md
