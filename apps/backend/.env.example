FINANCE_BACKEND_ENVIRONMENT=local
FINANCE_BACKEND_DEBUG=true

# Standard runtime entrypoint:
#   .\.venv\Scripts\uvicorn.exe app.main:app --host 127.0.0.1 --port 8000 --reload
#
# Seeded dev-only runtime for live PWA/Android integration:
#   .\.venv\Scripts\uvicorn.exe app.dev_seed:app --host 127.0.0.1 --port 8000 --reload

# Local PWA dev origins are allowed only outside production-like environments.
FINANCE_BACKEND_DEV_CORS_ALLOWED_ORIGINS='["http://127.0.0.1:5174","http://127.0.0.1:5173"]'

# Keep unset for default-deny auth in the standard app.main runtime.
# FINANCE_BACKEND_AUTH_TOKEN_HASH_SECRET=
