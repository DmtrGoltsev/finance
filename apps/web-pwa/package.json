{
  "name": "@finance/web-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:ios": "node ./scripts/build-ios.mjs",
    "cap:sync:ios": "npm run build:ios && cap sync ios",
    "cap:open:ios": "cap open ios",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@babel/core": ">=7.29.1 <8",
    "brace-expansion": ">=5.0.9 <6",
    "esbuild": ">=0.28.1 <0.29",
    "nanoid": ">=3.3.18 <4",
    "postcss": ">=8.5.23 <9",
    "tar": ">=7.5.21 <8",
    "ws": ">=8.21.0 <9"
  }
}
