{
  "id": "finance-metadata-retention-v1",
  "name": "Finance Queue and Retention v1",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false,
    "timezone": "Europe/Moscow",
    "executionTimeout": 1800
  },
  "nodes": [
    {
      "id": "finance-maintenance-timer",
      "name": "Каждую минуту",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "finance-http-drain",
      "name": "Обработать очередь gateway",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "finance-gateway-token",
          "name": "Finance Gateway Internal Token"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "http://analysis-gateway:8080/drain",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 1800000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": false,
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "finance-http-prune",
      "name": "Удалить истёкшие данные",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "finance-gateway-token",
          "name": "Finance Gateway Internal Token"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "http://analysis-gateway:8080/prune",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 1800000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": false,
              "responseFormat": "json"
            }
          }
        }
      }
    }
  ],
  "connections": {
    "Каждую минуту": {
      "main": [
        [
          {
            "node": "Обработать очередь gateway",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Обработать очередь gateway": {
      "main": [
        [
          {
            "node": "Удалить истёкшие данные",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
