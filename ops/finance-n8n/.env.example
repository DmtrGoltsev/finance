# Copy to .env and keep mode 0600. Never commit real values.
COMPOSE_PROJECT_NAME=finance-n8n
FINANCE_N8N_IMAGE=n8nio/n8n:2.39.8
FINANCE_N8N_POSTGRES_DB=finance_n8n
FINANCE_N8N_POSTGRES_USER=finance_n8n
FINANCE_N8N_POSTGRES_PASSWORD=replace-with-random-secret
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
FINANCE_INGRESS_HMAC_SECRET=replace-with-independent-random-secret
FINANCE_CALLBACK_HMAC_SECRET=replace-with-another-independent-random-secret
DEEPSEEK_API_KEY=replace-with-provider-key
DEEPSEEK_MODEL=deepseek-v4-pro
FINANCE_BACKEND_INTERNAL_URL=http://finance-backend:8000
FINANCE_N8N_LISTEN_ADDRESS=127.0.0.1
FINANCE_N8N_LISTEN_PORT=5680
TZ=Europe/Moscow
