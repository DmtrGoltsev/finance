# Только примеры. Рабочий файл хранится вне репозитория с правами 0600.
FINANCE_BACKEND_DATABASE_URL=postgresql+psycopg://finance_worker:replace-outside-repo@finance-db/finance
FINANCE_BACKEND_ENVIRONMENT=production
FINANCE_BACKEND_DATABASE_MIGRATION_POLICY=external
FINANCE_BACKEND_DELIVERY_N8N_URL=http://n8n:5678/webhook/internal/finance/investments/recommendations/v1
FINANCE_BACKEND_DELIVERY_INGRESS_SECRET=replace-with-separate-ingress-key-at-least-32-bytes
FINANCE_BACKEND_DELIVERY_LEASE_SECONDS=120
FINANCE_BACKEND_DELIVERY_MAX_ATTEMPTS=12
FINANCE_BACKEND_DELIVERY_POLL_SECONDS=5
FINANCE_BACKEND_FCM_ENABLED=false
FINANCE_BACKEND_FCM_PROJECT_ID=
FINANCE_BACKEND_FCM_CREDENTIALS_FILE=/run/secrets/finance-fcm.json
FINANCE_BACKEND_MOEX_REFRESH_SECIDS=[]
